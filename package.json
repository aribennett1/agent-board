{
  "name": "agent-board",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "npm --prefix ui run build",
    "setup": "npm ci && npm ci --prefix ui && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2"
  }
}
